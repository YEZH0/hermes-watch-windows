<Window x:Class="HermesFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="爱马仕表盘助手"
        Height="860" Width="1080" MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116"
        Foreground="#E8ECF2"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0E1116"/>
        <SolidColorBrush x:Key="Card" Color="#161A21"/>
        <SolidColorBrush x:Key="Line" Color="#242A34"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8ECF2"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A94A6"/>
        <SolidColorBrush x:Key="Accent" Color="#F2731C"/>
        <SolidColorBrush x:Key="Ok" Color="#3FB950"/>
        <SolidColorBrush x:Key="Bad" Color="#F85149"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#98A2B3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="1,0,0,5"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0F131A"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#4A3A2A"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F2731C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputPwd" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0F131A"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F2731C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#12151A"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF8434"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#3A3F49"/>
                                <Setter Property="Foreground" Value="#7C8595"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2E3542"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E242E"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3D4655"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A6270"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepChip" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2A303B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7686"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="#1B2029"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="12,5"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Border Grid.Row="0" Background="#11151B" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="26,18">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Accent}"
                            Margin="0,0,14,0">
                        <TextBlock Text="H" Foreground="#12151A" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="爱马仕表盘助手" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="给手表端补上缺失的 App Groups 权限，然后重新签名安装"
                                   FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6B7686"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="12"
                                   Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="26,20,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：表单 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                <StackPanel>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource CardTitle}" Text="1 · 签名文件" Margin="0"/>
                                <TextBlock Text="选 HermesEnabler.ipa" FontSize="11" Foreground="#5F6875"
                                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IpaBox" Grid.Column="0" Style="{StaticResource InputBox}"
                                         Margin="0,0,8,0" FontSize="12"
                                         TextChanged="IpaBox_TextChanged"/>
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource GhostButton}"
                                        Click="BrowseIpa_Click"/>
                            </Grid>
                            <TextBlock x:Name="IpaHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="可以直接把 .ipa 拖进这个窗口"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource CardTitle}" Text="2 · Apple 账号" Margin="0"/>
                                <TextBlock Text="免费账号即可，签出来 7 天有效" FontSize="11"
                                           Foreground="#5F6875" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Apple ID（邮箱）"/>
                            <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="密码" Margin="1,9,0,5"/>
                            <PasswordBox x:Name="PwdBox" Style="{StaticResource InputPwd}"/>
                            <CheckBox x:Name="RememberEmail" Content="记住邮箱" FontSize="12"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                      Margin="0,10,0,0"
                                      Checked="RememberEmail_Changed" Unchecked="RememberEmail_Changed"/>
                            <TextBlock Text="密码只交给本机进程，不写入磁盘、不进日志。"
                                       Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource CardTitle}" Text="3 · 开始" Margin="0"/>
                                <TextBlock Text="全程别拔线" FontSize="11" Foreground="#5F6875"
                                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="StartBtn" Content="开始签名并安装" Height="44"
                                    Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StopBtn" Grid.Column="0" Content="停止" Height="32"
                                        Style="{StaticResource GhostButton}" IsEnabled="False"
                                        Click="Stop_Click"/>
                                <Button x:Name="FolderBtn" Grid.Column="1" Content="打开日志目录" Height="32"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="OpenFolder_Click"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="签名期间保持 iPhone 解锁并插着数据线，手表放在充电器上。跑完还要去手表上打开确认，那一步电脑替不了。"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 右：进度 + 日志 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="StepsPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Style="{StaticResource StepChip}">
                        <TextBlock Style="{StaticResource StepText}" Text="1 · 登录 Apple"/>
                    </Border>
                    <Border Style="{StaticResource StepChip}">
                        <TextBlock Style="{StaticResource StepText}" Text="2 · 开发者会话"/>
                    </Border>
                    <Border Style="{StaticResource StepChip}">
                        <TextBlock Style="{StaticResource StepText}" Text="3 · 找到设备"/>
                    </Border>
                    <Border Style="{StaticResource StepChip}">
                        <TextBlock Style="{StaticResource StepText}" Text="4 · 签名安装"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="16,12,10,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="运行日志" FontSize="12" Foreground="{StaticResource TextDim}"/>
                                <TextBlock Text="技术细节，签不过时再看" FontSize="10.5"
                                           Foreground="#4E5764" Margin="9,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="清空" Style="{StaticResource GhostButton}" Padding="10,3"
                                    FontSize="11" HorizontalAlignment="Right" Click="ClearLog_Click"/>
                        </Grid>

                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 Background="#0A0D12" Foreground="#B4BFCE" BorderThickness="0"
                                 Padding="14,10" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                 FontSize="11.5" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>

                        <!-- 完成判定说明：电脑端跑完不等于手表端生效，这两件事分开验证。 -->
                        <Border Grid.Row="2" Background="#12161C" BorderBrush="{StaticResource Line}"
                                BorderThickness="0,1,0,0" Padding="16,9">
                            <TextBlock FontSize="10.5" Foreground="#6B7686" TextWrapping="Wrap"
                                       LineHeight="16"
                                       Text="这里显示的是电脑端的过程。进程正常退出，只代表签名和安装指令已经走完；手表上到底生效没有，要拿起手表打开 HermesEnabler 看一眼——不再报 App Group 错误，才算真的成功。"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 2FA 交互条 ============ -->
        <Border x:Name="TwoFaBar" Grid.Row="2" Margin="26,14,26,0" Visibility="Collapsed"
                Background="#1D1710" BorderBrush="#5A3A16" BorderThickness="1" CornerRadius="10"
                Padding="16,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#3A2A12"
                        Margin="0,0,13,0" VerticalAlignment="Center">
                    <TextBlock Text="2" Foreground="{StaticResource Accent}" FontWeight="Bold"
                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TwoFaTitle" Text="等两步验证码"
                               FontSize="12.5" Foreground="#F0C48A" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TwoFaHint" FontSize="11" Foreground="#9B8360"
                               Margin="0,3,0,0" TextWrapping="Wrap"
                               Text="Apple 默认发「推送」到受信任设备，不一定是短信。也可以输入 sms 1 指定号码。"/>

                    <!-- 常驻说明：这段不会被代码覆盖，专门回答"为什么收不到验证码"。
                         TwoFaHint 每个提示状态都会重写，所以不能往它里面塞。 -->
                    <Border Background="#191308" BorderBrush="#3A2A12" BorderThickness="1"
                            CornerRadius="6" Padding="9,7" Margin="0,7,0,0">
                        <TextBlock FontSize="10.5" Foreground="#8C7A5C" TextWrapping="Wrap"
                                   LineHeight="16"
                                   Text="收不到验证码？它可能落在另一台 iPhone、iPad 或 Mac 上，不一定是你正插着数据线的那台。点「短信」改走短信通道，点「再推送」让 Apple 重发。注意：发到 ≠ 一定送达，Apple 侧也可能限流。"/>
                    </Border>

                    <TextBox x:Name="TwoFaInput" Style="{StaticResource InputBox}" Margin="0,9,0,0"
                             Height="34" FontSize="15" MaxLength="24" Tag="6 位验证码"
                             KeyDown="TwoFaInput_KeyDown"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="14,0,0,0">
                    <Button x:Name="Submit2FaBtn" Content="提交" Height="34" MinWidth="72"
                            Style="{StaticResource PrimaryButton}" Click="Submit2FA_Click"/>
                    <Button Content="再推送" Height="34" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="Push2FA_Click"/>
                    <Button Content="短信" Height="34" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="Sms2FA_Click"/>
                    <Button Content="中止" Height="34" Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0" Click="Abort2FA_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 底部 ============ -->
        <Border Grid.Row="3" Padding="26,12,26,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="签名引擎：" FontSize="11" Foreground="#5F6875"/>
                    <TextBlock x:Name="EngineText" Text="检测中…" FontSize="11" Foreground="#7C8595"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                    <Button Content="更换" FontSize="11" Foreground="#8A94A6" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Click="ChangeEngine_Click"/>
                    <TextBlock Text="·" FontSize="11" Foreground="#3A4353" Margin="8,0"/>
                    <Button x:Name="SelfCheckBtn" Content="环境自检" FontSize="11" Foreground="#F0A25E"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="SelfCheck_Click"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="#4E5764" Text="v1.2 · 免费 Apple ID 自签，7 天需重签一次"/>
            </Grid>
        </Border>
    </Grid>
</Window>
