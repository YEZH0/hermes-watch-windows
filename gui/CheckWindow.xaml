<Window x:Class="HermesFix.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="环境自检"
        Height="640" Width="760" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#0E1116" Foreground="#E8ECF2"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#161A21"/>
        <SolidColorBrush x:Key="Line" Color="#242A34"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8ECF2"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A94A6"/>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2029"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232A35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="环境自检" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" FontSize="11.5" Foreground="{StaticResource TextDim}"
                       Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="检查签名前能确定的部分。判不了的项会标成「需人工」，不会假装通过。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="RerunBtn" Content="重新检测" Style="{StaticResource GhostButton}"
                        Click="Rerun_Click"/>
                <Button Content="复制报告" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="Copy_Click"/>
            </StackPanel>
            <Button Content="关闭" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
