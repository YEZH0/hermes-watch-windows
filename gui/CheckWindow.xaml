<Window x:Class="HermesFix.CheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="环境自检"
        Height="780" Width="800" MinHeight="440" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#0E1116" Foreground="#E8ECF2"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#161A21"/>
        <SolidColorBrush x:Key="Line" Color="#242A34"/>
        <SolidColorBrush x:Key="TextMain" Color="#E8ECF2"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A94A6"/>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2029"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#232A35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="环境自检" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" FontSize="11.5" Foreground="{StaticResource TextDim}"
                       Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="检查签名前能确定的部分。判不了的项会标成「需人工」，不会假装通过。"/>

            <!-- 四项判据的边界。这段是静态文字，不参与检测逻辑，
                 只负责让"通过"不被读成"一定没问题"。 -->
            <Border Background="#12161C" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="13,9" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="判据只说明条件成立，不等于结果一定成功：" FontSize="11"
                               Foreground="#7C8595" Margin="0,0,0,5"/>
                    <TextBlock FontSize="10.5" Foreground="#6B7686" TextWrapping="Wrap" LineHeight="16"
                               Text="· 服务在跑 ≠ 手机已连：还要插线、解锁、点过「信任此电脑」&#10;· 地址能连 ≠ 登录能成：账号侧还可能触发额外验证&#10;· 开发者模式只能自己去手表上看，「需人工」不是报错"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RerunBtn" Content="重新检测" Style="{StaticResource GhostButton}"
                        Click="Rerun_Click"/>
                <Button Content="复制报告" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                        Click="Copy_Click"/>
            </StackPanel>

            <!-- 与 EnvCheck.Report 的实际输出保持一致：结论 + IPA 文件名 + 引擎位置（用户名已掩码）。 -->
            <TextBlock Grid.Column="1" FontSize="10.5" Foreground="#4E5764" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="14,0,12,0"
                       Text="报告只含各项结论、IPA 文件名和引擎位置，其中路径里的用户名已替换为 &lt;user&gt;；不含 Apple ID、密码、验证码或设备序列号。"/>

            <Button Grid.Column="2" Content="关闭" Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
